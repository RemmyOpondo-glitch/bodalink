<%
    var _path = typeof currentPath !== "undefined" ? currentPath : "";
    function _current(href) { return _path === href ? ' aria-current="page"' : ""; }
%>
<%# Loader, skip link and progress bar come first in the page, before the header. %>
<div class="page-loader" id="pageLoader" aria-hidden="true">
    <div class="page-loader__inner">
        <span class="logo-mark">B</span>
        <div class="page-loader__road"></div>
    </div>
</div>

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="scroll-progress" aria-hidden="true"><div class="scroll-progress__bar" id="scrollProgress"></div></div>

<header class="site-header" id="siteHeader">
    <nav class="navbar" aria-label="Main">
        <a class="logo" href="/">
            <span class="logo-mark" aria-hidden="true">B</span>
            <span>BodaLink</span>
        </a>

        <div class="nav-panel" id="navPanel">
            <ul class="nav-links">
                <li><a href="/"<%- _current("/") %>>Home</a></li>
                <li><a href="/trips"<%- _current("/trips") %>>Book Ride</a></li>
                <li><a href="/history"<%- _current("/history") %>>Trip History</a></li>
                <li><a href="/riders"<%- _current("/riders") %>>Riders</a></li>
            </ul>

            <div class="nav-account">
                <% if (user) { %>
                    <a class="avatar-link" href="/profile" aria-label="My profile"<%- _current("/profile") %>>
                        <% if (user.profile_photo) { %>
                            <img src="/uploads/<%= user.profile_photo %>" alt="" class="profile-photo" width="40" height="40">
                        <% } else { %>
                            <span class="profile-placeholder" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
                            </span>
                        <% } %>
                    </a>
                    <a href="/logout" class="btn btn--ghost btn--sm login_logout-btn">Logout</a>
                <% } else { %>
                    <a href="/login" class="btn btn--primary btn--sm login_logout-btn">Login</a>
                <% } %>
            </div>
        </div>

        <div class="nav-tools">
            <a class="icon-btn" href="/search" data-search-open aria-label="Search" title="Search (press /)">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </a>

            <button class="icon-btn theme-toggle" id="themeToggle" type="button" aria-label="Dark mode" aria-pressed="false" title="Switch to dark mode">
                <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>

            <button class="icon-btn nav-toggle" id="navToggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="navPanel">
                <svg class="icon-menu" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
        </div>
    </nav>
</header>
