{
  "expo": {
    "name": "BodaLink",
    "slug": "bodalink",
    "scheme": "bodalink",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "ke.bodalink.app"
    },
    "ios": {
      "bundleIdentifier": "ke.bodalink.app"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d3bd5f69-a567-4629-aae1-1cb24b117237"
      }
    }
  }
}
